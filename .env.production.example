# ═══════════════════════════════════════════════════════════════════
# kozy.mu — production environment template (kozy.ryndia.space)
# ═══════════════════════════════════════════════════════════════════
# setup-production.sh copies this to .env and fills every __GENERATE__
# placeholder with a random secret. Anything marked __SET_ME__ must be
# filled in by hand before the site is useful.
# ═══════════════════════════════════════════════════════════════════

APP_NAME="Kozy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://kozy.ryndia.space

# Nginx on the host terminates TLS and proxies over the loopback.
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database (MySQL container) ─────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kozy
DB_USERNAME=kozy
DB_PASSWORD=__GENERATE__
# Used only by the MySQL container for the root account / healthcheck.
DB_ROOT_PASSWORD=__GENERATE__

# ── Redis (cache, sessions, queue) ─────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__GENERATE__
REDIS_PREFIX=kozy_database_

# ── Session / cache / queue drivers ────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Host-scoped on purpose: do NOT share cookies with other *.ryndia.space apps.
SESSION_DOMAIN=kozy.ryndia.space
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
CACHE_PREFIX=kozy_

QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
# Uploads explicitly target the "public" disk (Filament + PropertyImage),
# so this only affects code that asks for the default disk.
FILESYSTEM_DISK=local

# ── Mail ───────────────────────────────────────────────────────────
# Option A (default): relay through the docker-mailserver already running
#   on this VPS — reachable from the container as host.docker.internal:25.
# Option B: an external provider (Mailgun, Postmark, SES, Resend SMTP…).
MAIL_MAILER=smtp
MAIL_HOST=host.docker.internal
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@kozy.mu"
MAIL_FROM_NAME="Kozy"

# ── Stripe ─────────────────────────────────────────────────────────
# Leave empty to settle bookings manually instead of charging cards.
STRIPE_KEY=__SET_ME__
STRIPE_SECRET=__SET_ME__
STRIPE_WEBHOOK_SECRET=__SET_ME__

# ── AWS / S3 (optional — only if you move uploads off local disk) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Frontend build-time vars ───────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_STRIPE_KEY="${STRIPE_KEY}"

# ── Docker / Sail runtime ──────────────────────────────────────────
# Ports are offset from visual.ryndia.space (8080 / 3307 / 6380) so both
# stacks can share the VPS. Change them if anything else already binds.
WWWGROUP=1000
WWWUSER=1000
APP_PORT=8081
FORWARD_DB_PORT=3308
FORWARD_REDIS_PORT=6381
